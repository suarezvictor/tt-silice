// include VGA signal generator
$include('../common/vga.si')

// -------------------------

$include('shader.si')

algorithm vga_demo(
  output! uint2 video_r,
  output! uint2 video_g,
  output! uint2 video_b,
  output  uint1 video_hs,
  output  uint1 video_vs,
) {

  uint8 r = uninitialized;
  uint8 g = uninitialized;
  uint8 b = uninitialized;

  vga vga(
    vga_hs :> video_hs,
    vga_vs :> video_vs,
  );

  shader shader(
    x <: vga.vga_x,
    y <: vga.vga_y,
    r :> r,
    g :> g,
    b :> b,
  );

  always
  {
    video_r = vga.active ? r[6,2] : 2b0;
    video_g = vga.active ? g[6,2] : 2b0;
    video_b = vga.active ? b[6,2] : 2b0;
  }

}

// -------------------------
